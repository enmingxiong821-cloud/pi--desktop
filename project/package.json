{
  "name": "pi-desktop-poc",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Pi 桌面工作台：真实 Pi TUI + 图形辅助，多项目会话、模型路由、联网抓取、逆向分析与安全审计",
  "author": {
    "name": "enmingxiong821-cloud",
    "url": "https://github.com/enmingxiong821-cloud"
  },
  "license": "MIT",
  "homepage": "https://github.com/enmingxiong821-cloud/pi--desktop#readme",
  "bugs": {
    "url": "https://github.com/enmingxiong821-cloud/pi--desktop/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/enmingxiong821-cloud/pi--desktop.git"
  },
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "i18n:check": "node .smoke/i18n-missing.mjs",
    "test:config-share": "node .smoke/config-share-test.mjs",
    "smoke": "node scripts/pty-smoke.mjs",
    "verify": "npm run typecheck && npm run i18n:check && npm run test:config-share && npm run build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "44.8.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "electron@44.8.0": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  },
  "build": {
    "appId": "com.pi.workbench",
    "productName": "Pi 工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/design-skills/**/*",
      "resources/bundled-skills/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "artifactName": "Pi-Workbench-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Pi-Workbench-${version}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Pi 工作台"
    },
    "portable": {
      "artifactName": "Pi-Workbench-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "enmingxiong821-cloud <enmingxiong821-cloud@users.noreply.github.com>"
    }
  }
}
